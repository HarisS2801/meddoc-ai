# ============================================================
# MedDoc AI backend environment configuration
# Copy this file to `.env` next to this file (backend/.env) and fill in
# your real values. NEVER commit the real `.env` (it is gitignored).
# ============================================================

# --- Groq AI (the ONLY AI provider) -------------------------
# Groq handles summarization, chat, and structured extraction through its
# OpenAI-compatible API. No other provider (Gemini, OpenAI, mock) exists.
# When the key is missing or Groq fails, the app returns one controlled
# 503 "GROQ_UNAVAILABLE" instead of fabricating medical content.
GROQ_API_KEY=

# Model used for chat completions. Keep it a current Groq model; the
# default below is widely available.

# How long (seconds) a single Groq request may take before it is treated
# as a timeout and surfaced as GROQ_UNAVAILABLE.
GROQ_TIMEOUT_SECONDS=30

# Provider selector. The app is Groq-only; keep this as "groq".
AI_PROVIDER=groq

# --- RAG pipeline --------------------------------------------
# Top-K passages to retrieve for grounding chat answers, and the cosine
# gate for the local lexical embeddings (Groq has no embedding API).
TOP_K=4
SIMILARITY_THRESHOLD=0.90

# --- Storage (optional overrides) ----------------------------
# UPLOAD_DIR=./data/uploads
# DATABASE_URL=sqlite:///./data/meddoc.db
# CHROMA_DIR=./data/chroma

# Max allowed file size in megabytes (default 10).
MAX_UPLOAD_SIZE_MB=10

# --- Logging -------------------------------------------------
LOG_LEVEL=INFO

GROQ_MODEL=openai/gpt-oss-120b
