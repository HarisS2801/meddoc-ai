# ============================================================
# MedDoc AI environment configuration
# Copy this file to `backend/.env` and fill in your real values.
# NEVER commit the real `.env` file.
# ============================================================

# --- OpenAI API -------------------------------------------------
# Sign up at https://platform.openai.com to get a key.
# Leave empty to run in "mock mode" (tests use fake responses).
OPENAI_API_KEY=

# Configurable model names. Defaults are cheap and reliable.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG pipeline tuning ------------------------------------------
# These are defaults only. They are evaluation targets, not absolutes.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
SIMILARITY_THRESHOLD=0.30

# --- Storage (optional overrides) -----------------------------------
# By default files, the SQLite DB, and Chroma data live under
# backend/data/. Override only if you need a custom location.
# UPLOAD_DIR=./data/uploads
# DATABASE_URL=sqlite:///./data/meddoc.db
# CHROMA_DIR=./data/chroma

# Max allowed file size in megabytes (default 10).
MAX_UPLOAD_SIZE_MB=10

# --- Logging ------------------------------------------------------
LOG_LEVEL=INFO