# ============================================================
# MedDoc AI environment configuration
# Copy this file to `backend/.env` and fill in your real values.
# NEVER commit the real `.env` file.
# ============================================================

# --- Groq API (the ONLY AI provider) -------------------------
# Sign up at https://console.groq.com to get a key (starts with "gsk_").
# Groq handles summarization, chat, extraction, and the evaluation
# harness judge through its OpenAI-compatible API. When the key is empty,
# AI calls fail with a controlled "GROQ_UNAVAILABLE" 503 error and the
# app never fabricates answers (offline regex extraction still works).
# Leave empty to run fully offline (tests use fake HTTP responses).
GROQ_API_KEY=

# Configurable model name. Default is cheap and reliable.

# Timeout for Groq requests in seconds.
GROQ_TIMEOUT_SECONDS=30

# Embedding dimensions for the local lexical (offline) embedding provider.
# Groq has no embedding API; embeddings are always computed locally.
# Changing this invalidates existing vectors (clear backend/data/chroma).
EMBEDDING_DIMENSIONS=1536

# --- RAG pipeline tuning ------------------------------------------
# These are defaults only. They are evaluation targets, not absolutes.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Relevance gate for the local lexical embeddings.
SIMILARITY_THRESHOLD=0.90

# --- Storage (optional overrides) -----------------------------------
# By default files, the SQLite DB, and Chroma data live under
# backend/data/. Override only if you need a custom location.
# UPLOAD_DIR=./data/uploads
# DATABASE_URL=sqlite:///./data/meddoc.db
# CHROMA_DIR=./data/chroma

# Max allowed file size in megabytes (default 10).
MAX_UPLOAD_SIZE_MB=10

# --- Logging ------------------------------------------------------
LOG_LEVEL=INFO

GROQ_MODEL=openai/gpt-oss-120b
